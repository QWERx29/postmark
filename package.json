{
  "name": "postmark-system",
  "version": "1.1.0",
  "description": "新一代日戳管理系统 — 桌面版",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "start:web": "node launch.js",
    "start:server": "node server.js",
    "migrate:browser": "node scripts/migrate-to-chrome.js",
    "migrate:webview2": "node scripts/migrate-to-chrome.js --preset=webview2",
    "stage:tauri": "node scripts/stage-tauri-resources.js",
    "build:tauri": "pwsh -File scripts/dev-build-tauri.ps1",
    "start:electron": "electron .",
    "build": "electron-builder --win portable",
    "build:installer": "electron-builder --win"
  },
  "author": "QWERx29",
  "license": "MIT",
  "build": {
    "appId": "com.postmark.system",
    "productName": "新一代日戳管理系统",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!node_modules/**/*",
      "node_modules/echarts/dist/echarts.min.js",
      "node_modules/xlsx/dist/xlsx.full.min.js",
      "node_modules/jsbarcode/dist/JsBarcode.all.min.js",
      "node_modules/iconv-lite/**/*",
      "node_modules/safer-buffer/**/*",
      "!release/**",
      "!.claude/**",
      "!output/**",
      "!data/**",
      "!scripts/**",
      "!__pycache__/**",
      "!_regress_*.json"
    ],
    "asarUnpack": [
      "txt_compare.exe"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": null
    }
  },
  "devDependencies": {
    "electron": "^39.2.3",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "echarts": "^5.5.0",
    "iconv-lite": "^0.7.3",
    "jsbarcode": "^3.11.6",
    "xlsx": "^0.18.5"
  }
}
