{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "新一代日戳管理系统",
  "version": "1.1.0",
  "identifier": "com.postmark.system",
  "build": {
    "frontendDist": "resources/app"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "resources/": "resources/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
